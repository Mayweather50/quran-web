# Quran Platform - Nginx site config for one-domain VPS deployment.
# Copy to /etc/nginx/sites-available/quran-web and replace server_name.

server {
    listen 80;
    listen [::]:80;

    server_name hifz-center.site www.hifz-center.site;
    root /var/www/quran-web;
    index index.html;

    client_max_body_size 2m;

    # Backend API: Express listens only behind Nginx on localhost:3001.
    location = /api {
        return 301 /api/;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # Static frontend pages. /booking and /booking.html both work.
    location / {
        try_files $uri $uri/ $uri.html /index.html;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|gif|webp|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }
}
