# =============================================================
# Quran Platform Backend — environment template
# Copy this file to ".env" and fill in real values.
# =============================================================

# ------- PostgreSQL connection -------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quran_platform
DB_USER=postgres
DB_PASSWORD=
# Use true for cloud PostgreSQL providers that require sslmode=require
DB_SSL=false

# ------- HTTP server -------
PORT=3001

# ------- CORS -------
# Comma-separated list of allowed origins for the frontend
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
# Local file:// pages send Origin: null. Keep enabled for local testing,
# set ALLOW_FILE_ORIGIN=false in production if the frontend is always served via http(s).
ALLOW_FILE_ORIGIN=true

# ------- Auth -------
# REQUIRED in production. Pick a long random string.
# In dev, the server falls back to "dev-secret-change-me" with a warning.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ------- Dev fallback (optional) -------
# If set, requests without a valid Authorization header are treated as
# coming from this user. Useful when poking the API with curl.
# Leave empty in production.
CURRENT_USER_ID=

# ------- Debugging (optional) -------
LOG_QUERIES=false
LOG_REQUESTS=true
