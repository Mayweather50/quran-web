# =============================================================
# Quran Platform Backend - production environment template
# Copy to backend/.env on the VPS and fill real values.
# Never commit backend/.env.
# =============================================================

# ------- Runtime -------
NODE_ENV=production
PORT=3001

# ------- PostgreSQL on the same VPS -------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=quran_platform
DB_USER=quran_app
DB_PASSWORD=replace_with_a_strong_database_password
DB_SSL=false

# ------- CORS -------
# After the domain is connected, keep only the real site origins.
FRONTEND_ORIGIN=https://hifz-center.site,https://www.hifz-center.site
ALLOW_FILE_ORIGIN=false

# ------- Auth -------
# Generate a long random value before release:
# openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# ------- Dev fallback -------
# Must stay empty in production.
CURRENT_USER_ID=

# ------- Logging -------
LOG_QUERIES=false
LOG_REQUESTS=false
